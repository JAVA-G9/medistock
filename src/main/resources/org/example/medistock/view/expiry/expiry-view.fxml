<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="16.0" styleClass="view-content-root"
      stylesheets="/com/medistock/css/main.css"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.medistock.controller.expiry.ExpiryController">

    <!-- Header Section -->
    <HBox alignment="CENTER_LEFT" spacing="12.0">
        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
            <Label text="Medicine Expiry Monitoring &amp; Alerts" styleClass="view-title"/>
            <Label text="Real-time automated scanning of medicine batches, threshold risk alerts &amp; quarantine management."
                   styleClass="view-subtitle"/>
        </VBox>
        <Label fx:id="lblDaemonStatusPill" text="DAEMON ACTIVE" styleClass="badge-daemon"/>
        <Label text="MEMBER 4" styleClass="badge-eval"/>
    </HBox>

    <ScrollPane fitToWidth="true" styleClass="view-scroll" VBox.vgrow="ALWAYS">
        <VBox spacing="16.0" styleClass="view-scroll-content">

            <!-- KPI Metric Cards -->
            <HBox spacing="16.0">
                <!-- Amber KPI: Near-Expiry <= 30 Days -->
                <VBox HBox.hgrow="ALWAYS" styleClass="kpi-card, kpi-amber">
                    <Label text="NEAR-EXPIRY (&lt;= 30 DAYS)" styleClass="kpi-label"/>
                    <Label fx:id="lblKpiNearExpiry" text="0" styleClass="kpi-value"/>
                    <Label text="Requires priority exchange / sale" styleClass="kpi-subtext"/>
                </VBox>

                <!-- Soft Red / Amber KPI: Critical <= 15 Days -->
                <VBox HBox.hgrow="ALWAYS" styleClass="kpi-card, kpi-blue">
                    <Label text="CRITICAL (&lt;= 15 DAYS)" styleClass="kpi-label"/>
                    <Label fx:id="lblKpiCritical" text="0" styleClass="kpi-value"/>
                    <Label text="High urgent risk of expiration" styleClass="kpi-subtext"/>
                </VBox>

                <!-- Purple KPI: Expired Batches -->
                <VBox HBox.hgrow="ALWAYS" styleClass="kpi-card, kpi-purple">
                    <Label text="EXPIRED BATCHES" styleClass="kpi-label"/>
                    <Label fx:id="lblKpiExpired" text="0" styleClass="kpi-value"/>
                    <Label text="Zero saleability — quarantine immediately" styleClass="kpi-subtext"/>
                </VBox>

                <!-- Teal KPI: Total At-Risk Financial Value -->
                <VBox HBox.hgrow="ALWAYS" styleClass="kpi-card, kpi-teal">
                    <Label text="ESTIMATED AT-RISK VALUE" styleClass="kpi-label"/>
                    <Label fx:id="lblKpiAtRiskValue" text="0.00" styleClass="kpi-value"/>
                    <Label text="Calculated potential inventory loss" styleClass="kpi-subtext"/>
                </VBox>
            </HBox>

            <!-- Multithreading Daemon Status Card -->
            <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="info-card">
                <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                    <HBox spacing="8.0" alignment="CENTER_LEFT">
                        <Label text="⚙ Background Daemon Expiry Monitor" style="-fx-font-weight: bold; -fx-text-fill: #1e3a8a; -fx-font-size: 13px;"/>
                        <Label fx:id="lblThreadState" text="State: TIMED_WAITING" styleClass="badge-active-threads"/>
                    </HBox>
                    <Label fx:id="lblDaemonCycleInfo" text="Sweep Cycle: #1 | Last Scan: Just now | Background interval: 5000 ms" styleClass="text-muted"/>
                </VBox>
                <Button fx:id="btnTriggerScan" text="⚡ Scan Now" onAction="#handleTriggerImmediateScan" styleClass="btn-action-primary"/>
                <Button fx:id="btnToggleDaemon" text="⏸ Pause Monitor" onAction="#handleToggleDaemon" styleClass="btn-action-secondary"/>
            </HBox>

            <!-- Action Strip / Toolbar -->
            <HBox spacing="12.0" alignment="CENTER_LEFT" styleClass="action-strip">
                <Label text="Filter Records:" styleClass="action-strip-title"/>
                <TextField fx:id="txtSearch" promptText="Search by medicine name or batch #..." styleClass="input-field" HBox.hgrow="ALWAYS"/>
                <ComboBox fx:id="cmbStatusFilter" promptText="All Risk Levels" styleClass="input-field" prefWidth="180.0"/>
                <Button text="⟳ Refresh" onAction="#handleRefresh" styleClass="btn-action-secondary"/>
                <Button text="🗑 Dispose Expired" onAction="#handleDisposeExpired" styleClass="btn-lab-pri-high"/>
            </HBox>

            <!-- Table Card -->
            <VBox spacing="8.0" styleClass="table-card" VBox.vgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <Label text="📋 Tracked Medicine Batches &amp; Expiry Schedule" styleClass="card-section-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblTableCount" text="Showing 0 batches" styleClass="text-muted"/>
                </HBox>

                <TableView fx:id="expiryTableView" styleClass="medistock-table" prefHeight="320.0" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colBatchNumber" text="Batch #" prefWidth="130.0"/>
                        <TableColumn fx:id="colMedicineName" text="Medicine Name" prefWidth="220.0"/>
                        <TableColumn fx:id="colExpiryDate" text="Expiry Date" prefWidth="130.0"/>
                        <TableColumn fx:id="colDaysRemaining" text="Timeline" prefWidth="130.0"/>
                        <TableColumn fx:id="colQuantity" text="Units" prefWidth="90.0"/>
                        <TableColumn fx:id="colUnitPrice" text="Unit Price ($)" prefWidth="100.0"/>
                        <TableColumn fx:id="colTotalValue" text="Batch Value ($)" prefWidth="110.0"/>
                        <TableColumn fx:id="colStatus" text="Risk Status" prefWidth="130.0"/>
                    </columns>
                </TableView>
            </VBox>

        </VBox>
    </ScrollPane>
</VBox>
