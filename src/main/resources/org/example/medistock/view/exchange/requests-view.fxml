<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="8.0" styleClass="exchange-tab-content"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.medistock.controller.exchange.RequestsController">

    <!-- Responsive Header Block -->
    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <Label text="📋 Exchange Requests &amp; Stock Transfer Tracking" styleClass="card-section-title" minWidth="-Infinity"/>
        <Label text="• Multi-pharmacy approval workflow and secure transit verification" styleClass="text-muted"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="badgeFacilityReq" text="FACILITY" styleClass="license-badge-pill" minWidth="-Infinity"/>
        <Label text="MEMBER 3 • EVALUATION 1" styleClass="badge-eval" minWidth="-Infinity"/>
    </HBox>

    <!-- Compact KPI Metric Cards -->
    <HBox spacing="10.0">
        <!-- Amber KPI: Incoming Requests Awaiting Approval -->
        <VBox HBox.hgrow="ALWAYS" styleClass="kpi-card, kpi-amber" minWidth="150.0">
            <Label text="INCOMING PENDING REQUESTS" styleClass="kpi-label" minWidth="-Infinity"/>
            <Label fx:id="kpiIncomingPending" text="1" styleClass="kpi-value"/>
            <Label text="Requires approval or rejection" styleClass="kpi-subtext" minWidth="-Infinity"/>
        </VBox>

        <!-- Blue KPI: Outgoing Requests Placed -->
        <VBox HBox.hgrow="ALWAYS" styleClass="kpi-card, kpi-blue" minWidth="150.0">
            <Label text="OUTGOING STOCK REQUESTS" styleClass="kpi-label" minWidth="-Infinity"/>
            <Label fx:id="kpiOutgoingRequests" text="1" styleClass="kpi-value"/>
            <Label text="Requested from peer pharmacies" styleClass="kpi-subtext" minWidth="-Infinity"/>
        </VBox>

        <!-- Teal KPI: Active Transfers -->
        <VBox HBox.hgrow="ALWAYS" styleClass="kpi-card, kpi-teal" minWidth="150.0">
            <Label text="ACTIVE STOCK TRANSFERS" styleClass="kpi-label" minWidth="-Infinity"/>
            <Label fx:id="kpiActiveTransfers" text="1" styleClass="kpi-value"/>
            <Label text="In-transit &amp; pending verification" styleClass="kpi-subtext" minWidth="-Infinity"/>
        </VBox>
    </HBox>

    <!-- Responsive Toolbar / Action Strip -->
    <HBox spacing="10.0" alignment="CENTER_LEFT" styleClass="action-strip">
        <Label text="Active Pharmacy:" styleClass="field-label" minWidth="-Infinity"/>
        <ComboBox fx:id="pharmacyComboBox" prefWidth="260.0" minWidth="180.0" styleClass="input-field"/>

        <Region HBox.hgrow="ALWAYS"/>

        <Label fx:id="statusLabel" text="Ready" styleClass="text-muted" minWidth="-Infinity"/>
        <Button text="⟳ Refresh All" onAction="#handleRefresh" styleClass="btn-action-secondary" minWidth="-Infinity"/>
    </HBox>

    <!-- Tab Pane for Requests and Transfers (Calibrated for 5 entries) -->
    <TabPane tabClosingPolicy="UNAVAILABLE" prefHeight="265.0" minHeight="265.0" maxHeight="265.0" styleClass="table-card, sub-tab-pane">
        <!-- Tab 1: Incoming Requests -->
        <Tab text="📥 Incoming Requests (For My Listings)">
            <VBox spacing="8.0">
                <padding>
                    <Insets top="8.0" right="4.0" bottom="4.0" left="4.0"/>
                </padding>
                <TableView fx:id="incomingTable" fixedCellSize="28.0" prefHeight="172.0" minHeight="172.0" maxHeight="172.0" styleClass="medistock-table">
                    <columns>
                        <TableColumn fx:id="colIncId" prefWidth="80.0" text="Request ID" />
                        <TableColumn fx:id="colIncListing" prefWidth="80.0" text="Listing ID" />
                        <TableColumn fx:id="colIncRequester" prefWidth="180.0" text="Requester Pharmacy" />
                        <TableColumn fx:id="colIncMedicine" prefWidth="170.0" text="Medicine Name" />
                        <TableColumn fx:id="colIncQty" prefWidth="70.0" text="Qty" />
                        <TableColumn fx:id="colIncPrice" prefWidth="90.0" text="Unit Price (₹)" />
                        <TableColumn fx:id="colIncTotal" prefWidth="90.0" text="Total (₹)" />
                        <TableColumn fx:id="colIncStatus" prefWidth="90.0" text="Status" />
                        <TableColumn fx:id="colIncDate" prefWidth="120.0" text="Request Date" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
                <HBox spacing="10.0" alignment="CENTER_LEFT">
                    <Button onAction="#handleApproveRequest" styleClass="btn-action-primary" text="✅ Approve Selected Request" minWidth="-Infinity"/>
                    <Button onAction="#handleRejectRequest" styleClass="btn-secondary, btn-compact" text="❌ Reject (Release Escrow)" minWidth="-Infinity"/>
                </HBox>
            </VBox>
        </Tab>

        <!-- Tab 2: Outgoing Requests -->
        <Tab text="📤 My Outgoing Requests">
            <VBox spacing="8.0">
                <padding>
                    <Insets top="8.0" right="4.0" bottom="4.0" left="4.0"/>
                </padding>
                <TableView fx:id="outgoingTable" fixedCellSize="28.0" prefHeight="172.0" minHeight="172.0" maxHeight="172.0" styleClass="medistock-table">
                    <columns>
                        <TableColumn fx:id="colOutId" prefWidth="80.0" text="Request ID" />
                        <TableColumn fx:id="colOutListing" prefWidth="80.0" text="Listing ID" />
                        <TableColumn fx:id="colOutSeller" prefWidth="170.0" text="Seller Pharmacy" />
                        <TableColumn fx:id="colOutMedicine" prefWidth="170.0" text="Medicine Name" />
                        <TableColumn fx:id="colOutQty" prefWidth="70.0" text="Qty" />
                        <TableColumn fx:id="colOutPrice" prefWidth="90.0" text="Unit Price (₹)" />
                        <TableColumn fx:id="colOutTotal" prefWidth="90.0" text="Total (₹)" />
                        <TableColumn fx:id="colOutStatus" prefWidth="90.0" text="Status" />
                        <TableColumn fx:id="colOutDate" prefWidth="120.0" text="Request Date" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
                <HBox spacing="10.0" alignment="CENTER_LEFT">
                    <Button onAction="#handleCancelOutgoingRequest" styleClass="btn-secondary, btn-compact" text="🚫 Cancel Selected Request" minWidth="-Infinity"/>
                </HBox>
            </VBox>
        </Tab>

        <!-- Tab 3: Stock Transfers & Tracking -->
        <Tab text="🚚 Stock Transfers &amp; Tracking">
            <VBox spacing="8.0">
                <padding>
                    <Insets top="8.0" right="4.0" bottom="4.0" left="4.0"/>
                </padding>
                <TableView fx:id="transfersTable" fixedCellSize="28.0" prefHeight="172.0" minHeight="172.0" maxHeight="172.0" styleClass="medistock-table">
                    <columns>
                        <TableColumn fx:id="colTrfId" prefWidth="80.0" text="Transfer ID" />
                        <TableColumn fx:id="colTrfMedicine" prefWidth="170.0" text="Medicine Name" />
                        <TableColumn fx:id="colTrfQty" prefWidth="60.0" text="Qty" />
                        <TableColumn fx:id="colTrfSource" prefWidth="160.0" text="Source Pharmacy" />
                        <TableColumn fx:id="colTrfDest" prefWidth="160.0" text="Destination Pharmacy" />
                        <TableColumn fx:id="colTrfTracking" prefWidth="110.0" text="Tracking No" />
                        <TableColumn fx:id="colTrfStatus" prefWidth="100.0" text="Status" />
                        <TableColumn fx:id="colTrfCreated" prefWidth="120.0" text="Created" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
                <HBox spacing="8.0" alignment="CENTER_LEFT">
                    <Button onAction="#handleMarkDispatched" styleClass="btn-action-secondary" text="🚚 Mark Dispatched" minWidth="-Infinity"/>
                    <Button onAction="#handleMarkDelivered" styleClass="btn-action-primary" text="📦 Mark Delivered" minWidth="-Infinity"/>
                    <Button onAction="#handleVerifyAndComplete" styleClass="btn-action-primary" text="✔️ Verify &amp; Complete Transfer" minWidth="-Infinity"/>
                </HBox>
            </VBox>
        </Tab>
    </TabPane>

    <!-- Compact Activity & Event Log (Info Card) -->
    <VBox spacing="3.0" styleClass="info-card">
        <Label text="⚡ Activity &amp; Event Notification Log" styleClass="info-title" minWidth="-Infinity"/>
        <TextArea fx:id="logArea" editable="false" prefHeight="48.0" minHeight="42.0" styleClass="console-area" wrapText="true"/>
    </VBox>

</VBox>
