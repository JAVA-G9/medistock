<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="8.0" styleClass="exchange-tab-content"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.medistock.controller.exchange.MarketplaceController">

    <!-- Compact Header Block -->
    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <Label text="🛒 Surplus Medicine Marketplace" styleClass="card-section-title"/>
        <Label text="• Peer-to-peer exchange with atomic reservation escrow" styleClass="text-muted"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="badgeFacility" text="LICENSED FACILITY" styleClass="license-badge-pill"/>
        <Label text="MEMBER 3 • EVALUATION 1" styleClass="badge-eval"/>
    </HBox>

    <!-- Compact KPI Metric Stat Cards -->
    <HBox spacing="10.0">
        <!-- Teal KPI: Total Available Listings -->
        <VBox HBox.hgrow="ALWAYS" styleClass="kpi-card, kpi-teal">
            <Label text="TOTAL ACTIVE LISTINGS" styleClass="kpi-label"/>
            <Label fx:id="kpiTotalListings" text="18" styleClass="kpi-value"/>
            <Label text="Available on marketplace" styleClass="kpi-subtext"/>
        </VBox>

        <!-- Blue KPI: My Active Listings -->
        <VBox HBox.hgrow="ALWAYS" styleClass="kpi-card, kpi-blue">
            <Label text="MY PHARMACY LISTINGS" styleClass="kpi-label"/>
            <Label fx:id="kpiMyListings" text="1" styleClass="kpi-value"/>
            <Label text="Published by current facility" styleClass="kpi-subtext"/>
        </VBox>

        <!-- Amber KPI: Reserved Units -->
        <VBox HBox.hgrow="ALWAYS" styleClass="kpi-card, kpi-amber">
            <Label text="RESERVED ESCROW UNITS" styleClass="kpi-label"/>
            <Label fx:id="kpiReservedStock" text="40 units" styleClass="kpi-value"/>
            <Label text="Locked in pending requests" styleClass="kpi-subtext"/>
        </VBox>

        <!-- Purple KPI: Concurrency Engine -->
        <VBox HBox.hgrow="ALWAYS" styleClass="kpi-card, kpi-purple">
            <Label text="CONCURRENCY ENGINE" styleClass="kpi-label"/>
            <Label text="ACTIVE" styleClass="kpi-value"/>
            <Label text="Intrinsic lock • Zero overselling" styleClass="kpi-subtext"/>
        </VBox>
    </HBox>

    <!-- Toolbar / Action Strip -->
    <HBox spacing="8.0" alignment="CENTER_LEFT" styleClass="action-strip">
        <Label text="Active Pharmacy:" styleClass="field-label"/>
        <ComboBox fx:id="pharmacyComboBox" prefWidth="220.0" styleClass="input-field"/>

        <Region HBox.hgrow="ALWAYS"/>

        <Label text="Filter:" styleClass="field-label"/>
        <TextField fx:id="searchField" prefWidth="160.0" promptText="Filter medicine, seller..." styleClass="input-field"/>

        <Button text="➕ Publish Surplus" onAction="#handlePublishListing" styleClass="btn-action-primary"/>
        <Button text="📥 Request Stock" onAction="#handleRequestStock" styleClass="btn-action-primary"/>
        <Button text="⚡ Concurrency Test" onAction="#handleRunConcurrencyTest" styleClass="btn-lab-primary, btn-compact"/>
        <Button text="❌ Cancel Listing" onAction="#handleCancelListing" styleClass="btn-lab-pri-high, btn-compact"/>
        <Button text="⟳ Refresh" onAction="#handleRefresh" styleClass="btn-action-secondary"/>
    </HBox>

    <!-- Expanded Table Card Container -->
    <VBox spacing="6.0" VBox.vgrow="ALWAYS" styleClass="table-card">
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <Label text="📦 Available Surplus Medicine Listings" styleClass="card-section-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="statusLabel" text="Ready" styleClass="text-muted"/>
        </HBox>

        <TableView fx:id="listingsTable" VBox.vgrow="ALWAYS" styleClass="medistock-table" minHeight="240.0" prefHeight="380.0">
            <columns>
                <TableColumn fx:id="colListingId" prefWidth="80.0" text="Listing ID" />
                <TableColumn fx:id="colMedicine" prefWidth="170.0" text="Medicine Name" />
                <TableColumn fx:id="colBatch" prefWidth="95.0" text="Batch No" />
                <TableColumn fx:id="colExpiry" prefWidth="90.0" text="Expiry Date" />
                <TableColumn fx:id="colAvailQty" prefWidth="75.0" text="Available" />
                <TableColumn fx:id="colReservedQty" prefWidth="75.0" text="Reserved" />
                <TableColumn fx:id="colTotalQty" prefWidth="75.0" text="Total Qty" />
                <TableColumn fx:id="colPrice" prefWidth="90.0" text="Unit Price (₹)" />
                <TableColumn fx:id="colSeller" prefWidth="180.0" text="Seller Pharmacy" />
                <TableColumn fx:id="colStatus" prefWidth="85.0" text="Status" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
    </VBox>

    <!-- Compact Multithreading & Event Execution Trace (Info Card) -->
    <VBox spacing="3.0" styleClass="info-card">
        <HBox alignment="CENTER_LEFT" spacing="8.0">
            <Label text="⚡ Multithreading &amp; Concurrency Trace" styleClass="info-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="Intrinsic monitor locks • Atomic reservations • EventProducer daemon" styleClass="info-bullet"/>
        </HBox>
        <TextArea fx:id="logArea" editable="false" prefHeight="48.0" minHeight="44.0" styleClass="console-area" wrapText="true"/>
    </VBox>

</VBox>
