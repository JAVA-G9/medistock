<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="10.0" styleClass="view-content-root"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.medistock.controller.exchange.MarketplaceController">

    <!-- Top View Header Block (Clean Enterprise Branding - No Blueprint Labels) -->
    <HBox alignment="CENTER_LEFT" spacing="12.0">
        <VBox spacing="2.0" HBox.hgrow="ALWAYS">
            <Label text="🛒 Surplus Medicine Marketplace" styleClass="view-title"/>
            <Label text="Peer-to-Peer Pharmacy Surplus Marketplace • Atomic Stock Reservation Escrow" styleClass="view-subtitle"/>
        </VBox>
        <Label fx:id="badgeFacility" text="LICENSED FACILITY" styleClass="license-badge-pill" minWidth="-Infinity"/>
    </HBox>

    <!-- Main Scrollable Content Container -->
    <ScrollPane fitToWidth="true" styleClass="view-scroll" VBox.vgrow="ALWAYS" hbarPolicy="NEVER">
        <VBox spacing="10.0" styleClass="view-scroll-content">

            <!-- 3 KPI Metric Stat Cards (Enhanced Font Sizing) -->
            <HBox spacing="10.0">
                <!-- Teal KPI: Total Available Listings -->
                <VBox HBox.hgrow="ALWAYS" styleClass="kpi-card, kpi-teal" minWidth="150.0">
                    <Label text="TOTAL ACTIVE LISTINGS" styleClass="kpi-label" minWidth="-Infinity"/>
                    <Label fx:id="kpiTotalListings" text="18" styleClass="kpi-value"/>
                    <Label text="Available on marketplace" styleClass="kpi-subtext" minWidth="-Infinity"/>
                </VBox>

                <!-- Blue KPI: My Active Listings -->
                <VBox HBox.hgrow="ALWAYS" styleClass="kpi-card, kpi-blue" minWidth="150.0">
                    <Label text="MY PHARMACY LISTINGS" styleClass="kpi-label" minWidth="-Infinity"/>
                    <Label fx:id="kpiMyListings" text="1" styleClass="kpi-value"/>
                    <Label text="Published by active facility" styleClass="kpi-subtext" minWidth="-Infinity"/>
                </VBox>

                <!-- Amber KPI: Reserved Units -->
                <VBox HBox.hgrow="ALWAYS" styleClass="kpi-card, kpi-amber" minWidth="150.0">
                    <Label text="RESERVED ESCROW UNITS" styleClass="kpi-label" minWidth="-Infinity"/>
                    <Label fx:id="kpiReservedStock" text="40 units" styleClass="kpi-value"/>
                    <Label text="Locked in pending requests" styleClass="kpi-subtext" minWidth="-Infinity"/>
                </VBox>
            </HBox>

            <!-- Responsive Filter & Search Toolbar Card -->
            <HBox spacing="10.0" alignment="CENTER_LEFT" styleClass="action-strip">
                <Button text="⟳ Refresh" onAction="#handleRefresh" styleClass="btn-action-secondary" minWidth="-Infinity"/>

                <Region HBox.hgrow="ALWAYS"/>

                <HBox spacing="8.0" alignment="CENTER_LEFT">
                    <Label text="Search Medicine:" styleClass="field-label" minWidth="-Infinity"/>
                    <TextField fx:id="searchField" prefWidth="220.0" minWidth="150.0" promptText="Filter listings..." styleClass="input-field"/>
                </HBox>
            </HBox>

            <!-- Table Card Container (Calibrated for 8 entries at 32px height + Action Buttons) -->
            <VBox spacing="8.0" styleClass="table-card">
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <Label text="📦 Available Surplus Medicine Listings" styleClass="card-section-title" minWidth="-Infinity"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="Showing listings across participating network" styleClass="text-muted" minWidth="-Infinity"/>
                </HBox>

                <TableView fx:id="listingsTable" fixedCellSize="32.0" prefHeight="350.0" minHeight="290.0" styleClass="medistock-table">
                    <columns>
                        <TableColumn fx:id="colListingId" prefWidth="75.0" minWidth="65.0" text="List ID" />
                        <TableColumn fx:id="colMedicine" prefWidth="155.0" minWidth="120.0" text="Medicine" />
                        <TableColumn fx:id="colBatch" prefWidth="85.0" minWidth="70.0" text="Batch" />
                        <TableColumn fx:id="colExpiry" prefWidth="85.0" minWidth="70.0" text="Expiry" />
                        <TableColumn fx:id="colAvailQty" prefWidth="65.0" minWidth="55.0" text="Avail" />
                        <TableColumn fx:id="colReservedQty" prefWidth="75.0" minWidth="65.0" text="Reserved" />
                        <TableColumn fx:id="colTotalQty" prefWidth="65.0" minWidth="55.0" text="Total" />
                        <TableColumn fx:id="colPrice" prefWidth="75.0" minWidth="65.0" text="Price (₹)" />
                        <TableColumn fx:id="colSeller" prefWidth="155.0" minWidth="120.0" text="Seller" />
                        <TableColumn fx:id="colStatus" prefWidth="75.0" minWidth="65.0" text="Status" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>

                <!-- Action Buttons & Status Feedback Row directly below Table -->
                <HBox spacing="8.0" alignment="CENTER_LEFT">
                    <Button text="➕ Publish Surplus" onAction="#handlePublishListing" styleClass="btn-action-primary" minWidth="-Infinity"/>
                    <Button text="📥 Request Stock" onAction="#handleRequestStock" styleClass="btn-action-primary" minWidth="-Infinity"/>
                    <Button text="❌ Cancel Listing" onAction="#handleCancelListing" styleClass="btn-secondary" minWidth="-Infinity"/>

                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="statusLabel" text="Ready" styleClass="text-muted" minWidth="-Infinity"/>
                </HBox>
            </VBox>

        </VBox>
    </ScrollPane>

</VBox>
