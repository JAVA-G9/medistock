<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane fitToWidth="true"
            hbarPolicy="NEVER"
            vbarPolicy="AS_NEEDED"
            style="-fx-background: #f1f5f9; -fx-background-color: #f1f5f9;"
            stylesheets="@../../css/main.css"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.medistock.controller.inventory.inventoryController">

   <content>
      <VBox spacing="22"
            fillWidth="true"
            style="-fx-background-color: #f1f5f9; -fx-padding: 25;">

         <children>

            <!-- HEADER -->
            <HBox alignment="CENTER_LEFT"
                  style="-fx-background-color: #0f766e; -fx-background-radius: 14; -fx-padding: 25; -fx-font-family: 'Segoe UI';">

               <children>
                  <VBox spacing="7" HBox.hgrow="ALWAYS">
                     <children>
                        <Label text="Inventory Workspace"
                               style="-fx-font-family: 'Segoe UI'; -fx-font-size: 25px; -fx-font-weight: bold; -fx-text-fill: white;"/>

                        <Label text="Manage medicines, monitor stock and maintain batch records."
                               style="-fx-font-family: 'Segoe UI'; -fx-font-size: 13px; -fx-text-fill: #ccfbf1;"/>
                     </children>
                  </VBox>

                  <Label text="MEDISTOCK"
                         style="-fx-font-family: 'Segoe UI'; -fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #ccfbf1;"/>
               </children>
            </HBox>


            <!-- STOCK TABLE -->
            <VBox spacing="14"
                  style="-fx-background-color: white; -fx-background-radius: 13; -fx-padding: 20; -fx-border-color: #e2e8f0; -fx-border-radius: 13;">

               <children>
                  <HBox alignment="CENTER_LEFT">
                     <children>
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                           <children>
                              <Label text="Stock Overview"
                                     style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #172b4d;"/>

                              <Label text="All medicine batches and their current availability"
                                     style="-fx-font-size: 12px; -fx-text-fill: #8492a6;"/>
                           </children>
                        </VBox>

                        <Label text="INVENTORY RECORDS"
                               style="-fx-background-color: #e6f7f4; -fx-background-radius: 20; -fx-padding: 7 12; -fx-text-fill: #087f70; -fx-font-size: 10px; -fx-font-weight: bold;"/>
                     </children>
                  </HBox>

                  <TableView fx:id="inventoryTable"
                             prefHeight="280"
                             minHeight="240"
                             styleClass="inventory-table">

                     <columns>
                        <TableColumn fx:id="medicineNameCol" text="Medicine" minWidth="130" prefWidth="180"/>
                        <TableColumn fx:id="batchNumberCol" text="Batch Number" minWidth="110" prefWidth="130"/>
                        <TableColumn fx:id="quantityReceivedCol" text="Received" minWidth="75" prefWidth="90"/>
                        <TableColumn fx:id="quantityAvailableCol" text="Available" minWidth="75" prefWidth="95"/>
                        <TableColumn fx:id="purchasePriceCol" text="Purchase Price" minWidth="100" prefWidth="115"/>
                        <TableColumn fx:id="sellingPriceCol" text="Selling Price" minWidth="100" prefWidth="110"/>
                        <TableColumn fx:id="expiryDateCol" text="Expiry Date" minWidth="100" prefWidth="115"/>
                     </columns>

                     <placeholder>
                        <Label text="No inventory records found."
                               style="-fx-text-fill: #94a3b8; -fx-font-size: 13px;"/>
                     </placeholder>
                  </TableView>
               </children>
            </VBox>

            <!-- TWO SIDE-BY-SIDE FORMS -->
            <HBox spacing="18" alignment="TOP_CENTER">

               <!-- MEDICINE FORM -->
               <VBox spacing="17"
                     minWidth="0"
                     HBox.hgrow="ALWAYS"
                     style="-fx-background-color: white; -fx-background-radius: 13; -fx-padding: 20; -fx-border-color: #e2e8f0; -fx-border-radius: 13;">

                  <children>
                     <VBox spacing="5">
                        <children>
                           <Label text="Medicine Details"
                                  style="-fx-font-size: 19px; -fx-font-weight: bold; -fx-text-fill: #172b4d;"/>

                           <Label text="Add or modify medicine information."
                                  style="-fx-font-size: 12px; -fx-text-fill: #8492a6;"/>
                        </children>
                     </VBox>

                     <GridPane hgap="13" vgap="13">
                        <columnConstraints>
                           <ColumnConstraints percentWidth="50"/>
                           <ColumnConstraints percentWidth="50"/>
                        </columnConstraints>

                        <children>

                           <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="0">
                              <children>
                                 <Label text="Medicine Name" styleClass="field-label"/>
                                 <TextField fx:id="getMedName" promptText="Medicine name" maxWidth="Infinity" styleClass="input-field"/>
                              </children>
                           </VBox>

                           <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="0">
                              <children>
                                 <Label text="Generic Name" styleClass="field-label"/>
                                 <TextField fx:id="getGenName" promptText="Generic name" maxWidth="Infinity" styleClass="input-field"/>
                              </children>
                           </VBox>

                           <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="1">
                              <children>
                                 <Label text="Manufacturer" styleClass="field-label"/>
                                 <TextField fx:id="getManName" promptText="Manufacturer" maxWidth="Infinity" styleClass="input-field"/>
                              </children>
                           </VBox>

                           <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="1">
                              <children>
                                 <Label text="Category" styleClass="field-label"/>
                                 <ComboBox fx:id="getCategory" editable="true" promptText="Select category" maxWidth="Infinity" styleClass="input-field"/>
                              </children>
                           </VBox>

                           <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="2">
                              <children>
                                 <Label text="Strength" styleClass="field-label"/>
                                 <TextField fx:id="getStrength" promptText="e.g. 500 mg" maxWidth="Infinity" styleClass="input-field"/>
                              </children>
                           </VBox>

                           <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="2">
                              <children>
                                 <Label text="Dosage Form" styleClass="field-label"/>
                                 <ComboBox fx:id="getDosage" editable="true" promptText="Select form" maxWidth="Infinity" styleClass="input-field"/>
                              </children>
                           </VBox>

                           <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="3" GridPane.columnSpan="2">
                              <children>
                                 <Label text="Description" styleClass="field-label"/>
                                 <TextArea fx:id="getDescription"
                                           promptText="Enter medicine description..."
                                           wrapText="true"
                                           prefHeight="75"
                                           maxWidth="Infinity"
                                           styleClass="input-field"/>
                              </children>
                           </VBox>

                        </children>
                     </GridPane>

                     <VBox spacing="9">
                        <children>
                           <HBox spacing="9">
                              <children>
                                 <Button fx:id="saveBtn"
                                         text="Save Medicine"
                                         onAction="#doSave"
                                         maxWidth="Infinity"
                                         HBox.hgrow="ALWAYS"
                                         style="-fx-background-color: #0d9488; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 7; -fx-padding: 10 12; -fx-cursor: hand;"/>

                                 <Button fx:id="updateBtn"
                                         text="Update"
                                         onAction="#doUpdate"
                                         maxWidth="Infinity"
                                         HBox.hgrow="ALWAYS"
                                         style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 7; -fx-padding: 10 12; -fx-cursor: hand;"/>
                              </children>
                           </HBox>

                           <HBox spacing="9">
                              <children>
                                 <Button fx:id="fetchBtn"
                                         text="Fetch Medicine"
                                         onAction="#doFetch"
                                         maxWidth="Infinity"
                                         HBox.hgrow="ALWAYS"
                                         style="-fx-background-color: #e8eef6; -fx-text-fill: #263d59; -fx-font-weight: bold; -fx-background-radius: 7; -fx-padding: 10 12; -fx-cursor: hand;"/>

                                 <Button fx:id="delBtn"
                                         text="Delete"
                                         onAction="#doDelete"
                                         maxWidth="Infinity"
                                         HBox.hgrow="ALWAYS"
                                         style="-fx-background-color: #fee2e2; -fx-text-fill: #b91c1c; -fx-font-weight: bold; -fx-background-radius: 7; -fx-padding: 10 12; -fx-cursor: hand;"/>

                                 <Button fx:id="clearBtn"
                                         text="Clear"
                                         onAction="#doClear"
                                         maxWidth="Infinity"
                                         HBox.hgrow="ALWAYS"
                                         style="-fx-background-color: #f1f5f9; -fx-text-fill: #475569; -fx-font-weight: bold; -fx-background-radius: 7; -fx-padding: 10 12; -fx-cursor: hand;"/>
                              </children>
                           </HBox>
                        </children>
                     </VBox>
                  </children>
               </VBox>

               <!-- BATCH FORM -->
               <VBox spacing="17"
                     minWidth="0"
                     HBox.hgrow="ALWAYS"
                     style="-fx-background-color: white; -fx-background-radius: 13; -fx-padding: 20; -fx-border-color: #e2e8f0; -fx-border-radius: 13;">

                  <children>
                     <VBox spacing="5">
                        <children>
                           <Label text="Batch Management"
                                  style="-fx-font-size: 19px; -fx-font-weight: bold; -fx-text-fill: #172b4d;"/>

                           <Label text="Maintain batch quantities, pricing and expiry."
                                  style="-fx-font-size: 12px; -fx-text-fill: #8492a6;"/>
                        </children>
                     </VBox>

                     <GridPane hgap="13" vgap="12">
                        <columnConstraints>
                           <ColumnConstraints percentWidth="50"/>
                           <ColumnConstraints percentWidth="50"/>
                        </columnConstraints>

                        <children>

                           <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="0">
                              <children>
                                 <Label text="Select Medicine" styleClass="field-label"/>
                                 <ComboBox fx:id="batchMedicine" promptText="Select medicine" maxWidth="Infinity" styleClass="input-field"/>
                              </children>
                           </VBox>

                           <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="0">
                              <children>
                                 <Label text="Batch Number" styleClass="field-label"/>
                                 <TextField fx:id="batchNumber" promptText="Batch number" maxWidth="Infinity" styleClass="input-field"/>
                              </children>
                           </VBox>

                           <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="1">
                              <children>
                                 <Label text="Manufacturing Date" styleClass="field-label"/>
                                 <DatePicker fx:id="manufacturingDate" promptText="Manufacturing date" maxWidth="Infinity" styleClass="input-field"/>
                              </children>
                           </VBox>

                           <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="1">
                              <children>
                                 <Label text="Expiry Date" styleClass="field-label"/>
                                 <DatePicker fx:id="expiryDate" promptText="Expiry date" maxWidth="Infinity" styleClass="input-field"/>
                              </children>
                           </VBox>

                           <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="2">
                              <children>
                                 <Label text="Quantity Received" styleClass="field-label"/>
                                 <TextField fx:id="quantityReceived" promptText="Received quantity" maxWidth="Infinity" styleClass="input-field"/>
                              </children>
                           </VBox>

                           <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="2">
                              <children>
                                 <Label text="Quantity Available" styleClass="field-label"/>
                                 <TextField fx:id="quantityAvailable" promptText="Available quantity" maxWidth="Infinity" styleClass="input-field"/>
                              </children>
                           </VBox>

                           <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="3">
                              <children>
                                 <Label text="Purchase Price" styleClass="field-label"/>
                                 <TextField fx:id="purchasePrice" promptText="Purchase price" maxWidth="Infinity" styleClass="input-field"/>
                              </children>
                           </VBox>

                           <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="3">
                              <children>
                                 <Label text="Selling Price" styleClass="field-label"/>
                                 <TextField fx:id="sellingPrice" promptText="Selling price" maxWidth="Infinity" styleClass="input-field"/>
                              </children>
                           </VBox>

                           <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="4">
                              <children>
                                 <Label text="Pharmacy ID" styleClass="field-label"/>
                                 <TextField fx:id="pharmacyId" text="PHARM-001" maxWidth="Infinity" styleClass="input-field"/>
                              </children>
                           </VBox>

                           <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="4">
                              <children>
                                 <Label text="Batch Status" styleClass="field-label"/>
                                 <ComboBox fx:id="batchStatus" promptText="Select status" maxWidth="Infinity" styleClass="input-field"/>
                              </children>
                           </VBox>

                           <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="5">
                              <children>
                                 <Label text="Received Date" styleClass="field-label"/>
                                 <DatePicker fx:id="receivedDate" promptText="Received date" maxWidth="Infinity" styleClass="input-field"/>
                              </children>
                           </VBox>

                        </children>
                     </GridPane>

                     <VBox spacing="9">
                        <children>
                           <HBox spacing="9">
                              <children>
                                 <Button fx:id="saveBatchBtn"
                                         text="Save Batch"
                                         onAction="#doSaveBatch"
                                         maxWidth="Infinity"
                                         HBox.hgrow="ALWAYS"
                                         style="-fx-background-color: #0d9488; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 7; -fx-padding: 10 12; -fx-cursor: hand;"/>

                                 <Button fx:id="updateBatchBtn"
                                         text="Update Batch"
                                         onAction="#doUpdateBatch"
                                         maxWidth="Infinity"
                                         HBox.hgrow="ALWAYS"
                                         style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 7; -fx-padding: 10 12; -fx-cursor: hand;"/>
                              </children>
                           </HBox>

                           <HBox spacing="9">
                              <children>
                                 <Button fx:id="fetchBatchBtn"
                                         text="Fetch Batch"
                                         onAction="#doFetchBatch"
                                         maxWidth="Infinity"
                                         HBox.hgrow="ALWAYS"
                                         style="-fx-background-color: #e8eef6; -fx-text-fill: #263d59; -fx-font-weight: bold; -fx-background-radius: 7; -fx-padding: 10 12; -fx-cursor: hand;"/>

                                 <Button fx:id="deleteBatchBtn"
                                         text="Delete Batch"
                                         onAction="#doDeleteBatch"
                                         maxWidth="Infinity"
                                         HBox.hgrow="ALWAYS"
                                         style="-fx-background-color: #fee2e2; -fx-text-fill: #b91c1c; -fx-font-weight: bold; -fx-background-radius: 7; -fx-padding: 10 12; -fx-cursor: hand;"/>

                                 <Button fx:id="clearBatchBtn"
                                         text="Clear"
                                         onAction="#doClearBatch"
                                         maxWidth="Infinity"
                                         HBox.hgrow="ALWAYS"
                                         style="-fx-background-color: #f1f5f9; -fx-text-fill: #475569; -fx-font-weight: bold; -fx-background-radius: 7; -fx-padding: 10 12; -fx-cursor: hand;"/>
                              </children>
                           </HBox>
                        </children>
                     </VBox>
                  </children>
               </VBox>

            </HBox>

         </children>
      </VBox>
   </content>
</ScrollPane>
