
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>

<VBox prefWidth="1000.0" prefHeight="750.0"
      maxWidth="Infinity" maxHeight="Infinity"
      spacing="18.0"
      styleClass="dashboard-root"
      stylesheets="@../../css/main.css"
      xmlns="http://javafx.com/javafx/26"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.medistock.controller.inventory.inventoryController">

   <children>

      <!-- Page Heading -->
      <VBox spacing="5.0" styleClass="view-content-root">
         <children>
            <Label text="My Inventory &amp; Batch Management"
                   styleClass="view-title"/>

            <Label text="Manage your medicine catalog and medicine details."
                   styleClass="view-subtitle"/>
         </children>
      </VBox>

      <!-- Form Card -->
      <VBox spacing="22.0" styleClass="form-card">
         <children>

            <Label text="Medicine Information"
                   styleClass="section-header"/>

            <GridPane hgap="20.0" vgap="22.0">
               <columnConstraints>
                  <javafx.scene.layout.ColumnConstraints percentWidth="17"/>
                  <javafx.scene.layout.ColumnConstraints percentWidth="33"/>
                  <javafx.scene.layout.ColumnConstraints percentWidth="17"/>
                  <javafx.scene.layout.ColumnConstraints percentWidth="33"/>
               </columnConstraints>

               <children>

                  <Label text="Medicine Name"
                         styleClass="field-label"
                         GridPane.columnIndex="0"
                         GridPane.rowIndex="0"/>

                  <TextField fx:id="getMedName"
                             promptText="Enter medicine name"
                             styleClass="input-field"
                             maxWidth="Infinity"
                             GridPane.columnIndex="1"
                             GridPane.rowIndex="0"/>

                  <Label text="Generic Name"
                         styleClass="field-label"
                         GridPane.columnIndex="2"
                         GridPane.rowIndex="0"/>

                  <TextField fx:id="getGenName"
                             promptText="Enter generic name"
                             styleClass="input-field"
                             maxWidth="Infinity"
                             GridPane.columnIndex="3"
                             GridPane.rowIndex="0"/>

                  <Label text="Manufacturer"
                         styleClass="field-label"
                         GridPane.columnIndex="0"
                         GridPane.rowIndex="1"/>

                  <TextField fx:id="getManName"
                             promptText="Enter manufacturer"
                             styleClass="input-field"
                             maxWidth="Infinity"
                             GridPane.columnIndex="1"
                             GridPane.rowIndex="1"/>

                  <Label text="Category"
                         styleClass="field-label"
                         GridPane.columnIndex="2"
                         GridPane.rowIndex="1"/>

                  <ComboBox fx:id="getCategory"
                            editable="true"
                            promptText="Select category"
                            styleClass="input-field"
                            maxWidth="Infinity"
                            GridPane.columnIndex="3"
                            GridPane.rowIndex="1"/>

                  <Label text="Strength"
                         styleClass="field-label"
                         GridPane.columnIndex="0"
                         GridPane.rowIndex="2"/>

                  <TextField fx:id="getStrength"
                             promptText="e.g. 500 mg"
                             styleClass="input-field"
                             maxWidth="Infinity"
                             GridPane.columnIndex="1"
                             GridPane.rowIndex="2"/>

                  <Label text="Dosage Form"
                         styleClass="field-label"
                         GridPane.columnIndex="2"
                         GridPane.rowIndex="2"/>

                  <ComboBox fx:id="getDosage"
                            editable="true"
                            promptText="Select dosage form"
                            styleClass="input-field"
                            maxWidth="Infinity"
                            GridPane.columnIndex="3"
                            GridPane.rowIndex="2"/>

                  <Label text="Description"
                         styleClass="field-label"
                         GridPane.columnIndex="0"
                         GridPane.rowIndex="3"/>

                  <TextArea fx:id="getDescription"
                            promptText="Enter medicine description..."
                            wrapText="true"
                            prefHeight="110.0"
                            maxWidth="Infinity"
                            styleClass="input-field"
                            GridPane.columnIndex="1"
                            GridPane.rowIndex="3"
                            GridPane.columnSpan="3"/>

               </children>
            </GridPane>

            <!-- Action Buttons -->
            <HBox spacing="14.0">
               <children>
                  <Button fx:id="saveBtn"
                          text="Save Medicine"
                          onAction="#doSave"
                          styleClass="btn-primary"/>

                  <Button fx:id="fetchBtn"
                          text="Fetch Medicine"
                          onAction="#doFetch"
                          styleClass="btn-secondary"/>

                  <Button fx:id="delBtn"
                          text="Delete Medicine"
                          onAction="#doDelete"
                          styleClass="btn-danger"/>

                  <Button fx:id="clearBtn"
                          text="Clear All"
                          onAction="#doClear"
                          styleClass="btn-secondary"/>
               </children>
            </HBox>

         </children>
      </VBox>

   </children>
</VBox>
