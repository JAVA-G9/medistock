<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true"
            hbarPolicy="NEVER"
            vbarPolicy="AS_NEEDED"
            styleClass="dashboard-root"
            stylesheets="@../../css/main.css"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.medistock.controller.inventory.inventoryController">

   <content>
      <VBox spacing="18.0"
            fillWidth="true"
            styleClass="dashboard-root">

         <children>

            <!-- PAGE HEADING -->
            <VBox spacing="5.0" styleClass="view-content-root">
               <children>
                  <Label styleClass="view-title"
                         text="My Inventory &amp; Batch Management"/>

                  <Label styleClass="view-subtitle"
                         text="Manage your medicine catalog and stock batches."/>
               </children>
            </VBox>

            <!-- INVENTORY STOCK TABLE -->
            <VBox spacing="16.0"
                  styleClass="form-card inventory-table-card">

               <children>

                  <VBox spacing="5.0">
                     <children>
                        <Label styleClass="section-header"
                               text="Inventory Stock"/>

                        <Label styleClass="view-subtitle"
                               text="View medicine batches, available quantities, prices and expiry dates."/>
                     </children>
                  </VBox>

                  <TableView fx:id="inventoryTable"
                             minHeight="280.0"
                             prefHeight="340.0"
                             styleClass="inventory-table">

                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                     </columnResizePolicy>

                     <columns>
                        <TableColumn fx:id="medicineNameCol"
                                     minWidth="140.0"
                                     text="Medicine"/>

                        <TableColumn fx:id="batchNumberCol"
                                     minWidth="115.0"
                                     text="Batch Number"/>

                        <TableColumn fx:id="quantityReceivedCol"
                                     minWidth="85.0"
                                     text="Received"/>

                        <TableColumn fx:id="quantityAvailableCol"
                                     minWidth="85.0"
                                     text="Available"/>

                        <TableColumn fx:id="purchasePriceCol"
                                     minWidth="105.0"
                                     text="Purchase Price"/>

                        <TableColumn fx:id="sellingPriceCol"
                                     minWidth="100.0"
                                     text="Selling Price"/>

                        <TableColumn fx:id="expiryDateCol"
                                     minWidth="105.0"
                                     text="Expiry Date"/>
                     </columns>

                     <placeholder>
                        <Label styleClass="table-empty-message"
                               text="No inventory records found."/>
                     </placeholder>

                  </TableView>

                  <!-- CONCURRENCY TEST -->
                  <VBox spacing="12.0"
                        styleClass="form-card">

                     <children>

                        <Label styleClass="section-header"
                               text="Stock Concurrency Test"/>

                        <Label styleClass="view-subtitle"
                               text="Test concurrent stock requests and synchronized access."/>

                        <Button fx:id="concurrencyTestBtn"
                                onAction="#runInventoryConcurrencyTest"
                                styleClass="btn-primary"
                                prefWidth="220.0"
                                text="Run Concurrency Test"/>

                     </children>
                  </VBox>

               </children>
            </VBox>

            <!-- FORM CARDS -->
            <HBox spacing="18.0" alignment="TOP_LEFT">

               <children>

                  <!-- MEDICINE INFORMATION -->
                  <VBox spacing="18.0"
                        prefWidth="0.0"
                        maxWidth="Infinity"
                        HBox.hgrow="ALWAYS"
                        styleClass="form-card">

                     <children>

                        <Label styleClass="section-header"
                               text="Medicine Information"/>

                        <GridPane hgap="14.0" vgap="16.0">

                           <columnConstraints>
                              <ColumnConstraints percentWidth="50.0"/>
                              <ColumnConstraints percentWidth="50.0"/>
                           </columnConstraints>

                           <children>

                              <!-- MEDICINE NAME -->
                              <VBox spacing="7.0"
                                    GridPane.columnIndex="0"
                                    GridPane.rowIndex="0">
                                 <children>
                                    <Label styleClass="field-label"
                                           text="Medicine Name"/>

                                    <TextField fx:id="getMedName"
                                               maxWidth="Infinity"
                                               promptText="Enter medicine name"
                                               styleClass="input-field"/>
                                 </children>
                              </VBox>

                              <!-- GENERIC NAME -->
                              <VBox spacing="7.0"
                                    GridPane.columnIndex="1"
                                    GridPane.rowIndex="0">
                                 <children>
                                    <Label styleClass="field-label"
                                           text="Generic Name"/>

                                    <TextField fx:id="getGenName"
                                               maxWidth="Infinity"
                                               promptText="Enter generic name"
                                               styleClass="input-field"/>
                                 </children>
                              </VBox>

                              <!-- MANUFACTURER -->
                              <VBox spacing="7.0"
                                    GridPane.columnIndex="0"
                                    GridPane.rowIndex="1">
                                 <children>
                                    <Label styleClass="field-label"
                                           text="Manufacturer"/>

                                    <TextField fx:id="getManName"
                                               maxWidth="Infinity"
                                               promptText="Enter manufacturer"
                                               styleClass="input-field"/>
                                 </children>
                              </VBox>

                              <!-- CATEGORY -->
                              <VBox spacing="7.0"
                                    GridPane.columnIndex="1"
                                    GridPane.rowIndex="1">
                                 <children>
                                    <Label styleClass="field-label"
                                           text="Category"/>

                                    <ComboBox fx:id="getCategory"
                                              editable="true"
                                              maxWidth="Infinity"
                                              promptText="Select category"
                                              styleClass="input-field"/>
                                 </children>
                              </VBox>

                              <!-- STRENGTH -->
                              <VBox spacing="7.0"
                                    GridPane.columnIndex="0"
                                    GridPane.rowIndex="2">
                                 <children>
                                    <Label styleClass="field-label"
                                           text="Strength"/>

                                    <TextField fx:id="getStrength"
                                               maxWidth="Infinity"
                                               promptText="e.g. 500 mg"
                                               styleClass="input-field"/>
                                 </children>
                              </VBox>

                              <!-- DOSAGE FORM -->
                              <VBox spacing="7.0"
                                    GridPane.columnIndex="1"
                                    GridPane.rowIndex="2">
                                 <children>
                                    <Label styleClass="field-label"
                                           text="Dosage Form"/>

                                    <ComboBox fx:id="getDosage"
                                              editable="true"
                                              maxWidth="Infinity"
                                              promptText="Select dosage form"
                                              styleClass="input-field"/>
                                 </children>
                              </VBox>

                              <!-- DESCRIPTION -->
                              <VBox spacing="7.0"
                                    GridPane.columnIndex="0"
                                    GridPane.columnSpan="2"
                                    GridPane.rowIndex="3">
                                 <children>
                                    <Label styleClass="field-label"
                                           text="Description"/>

                                    <TextArea fx:id="getDescription"
                                              maxWidth="Infinity"
                                              prefHeight="90.0"
                                              promptText="Enter medicine description..."
                                              styleClass="input-field"
                                              wrapText="true"/>
                                 </children>
                              </VBox>

                           </children>

                           <rowConstraints>
                              <RowConstraints/>
                              <RowConstraints/>
                              <RowConstraints/>
                              <RowConstraints/>
                           </rowConstraints>

                        </GridPane>

                        <!-- MEDICINE ACTIONS -->
                        <GridPane hgap="10.0" vgap="10.0">

                           <columnConstraints>
                              <ColumnConstraints percentWidth="50.0"/>
                              <ColumnConstraints percentWidth="50.0"/>
                           </columnConstraints>

                           <children>

                              <Button fx:id="saveBtn"
                                      onAction="#doSave"
                                      styleClass="btn-primary"
                                      maxWidth="Infinity"
                                      text="Save Medicine"
                                      GridPane.columnIndex="0"
                                      GridPane.rowIndex="0"/>

                              <Button fx:id="fetchBtn"
                                      onAction="#doFetch"
                                      styleClass="btn-secondary"
                                      maxWidth="Infinity"
                                      text="Fetch Medicine"
                                      GridPane.columnIndex="1"
                                      GridPane.rowIndex="0"/>

                              <Button fx:id="delBtn"
                                      onAction="#doDelete"
                                      styleClass="btn-danger"
                                      maxWidth="Infinity"
                                      text="Delete Medicine"
                                      GridPane.columnIndex="0"
                                      GridPane.rowIndex="1"/>

                              <Button fx:id="updateBtn"
                                      onAction="#doUpdate"
                                      styleClass="btn-secondary"
                                      maxWidth="Infinity"
                                      text="Update Medicine"
                                      GridPane.columnIndex="1"
                                      GridPane.rowIndex="1"/>

                              <Button fx:id="clearBtn"
                                      onAction="#doClear"
                                      styleClass="btn-secondary"
                                      maxWidth="Infinity"
                                      text="Clear All"
                                      GridPane.columnIndex="0"
                                      GridPane.rowIndex="2"/>

                           </children>

                        </GridPane>

                     </children>
                  </VBox>

                  <!-- BATCH MANAGEMENT -->
                  <VBox spacing="18.0"
                        prefWidth="0.0"
                        maxWidth="Infinity"
                        HBox.hgrow="ALWAYS"
                        styleClass="form-card">

                     <children>

                        <Label styleClass="section-header"
                               text="Medicine Batch Management"/>

                        <Label styleClass="view-subtitle"
                               text="Manage batch details and stock."/>

                        <GridPane hgap="14.0" vgap="16.0">

                           <columnConstraints>
                              <ColumnConstraints percentWidth="50.0"/>
                              <ColumnConstraints percentWidth="50.0"/>
                           </columnConstraints>

                           <children>

                              <!-- SELECT MEDICINE -->
                              <VBox spacing="7.0"
                                    GridPane.columnIndex="0"
                                    GridPane.rowIndex="0">
                                 <children>
                                    <Label styleClass="field-label"
                                           text="Select Medicine"/>

                                    <ComboBox fx:id="batchMedicine"
                                              maxWidth="Infinity"
                                              promptText="Select medicine"
                                              styleClass="input-field"/>
                                 </children>
                              </VBox>

                              <!-- BATCH NUMBER -->
                              <VBox spacing="7.0"
                                    GridPane.columnIndex="1"
                                    GridPane.rowIndex="0">
                                 <children>
                                    <Label styleClass="field-label"
                                           text="Batch Number"/>

                                    <TextField fx:id="batchNumber"
                                               maxWidth="Infinity"
                                               promptText="Enter batch number"
                                               styleClass="input-field"/>
                                 </children>
                              </VBox>

                              <!-- MANUFACTURING DATE -->
                              <VBox spacing="7.0"
                                    GridPane.columnIndex="0"
                                    GridPane.rowIndex="1">
                                 <children>
                                    <Label styleClass="field-label"
                                           text="Manufacturing Date"/>

                                    <DatePicker fx:id="manufacturingDate"
                                                maxWidth="Infinity"
                                                promptText="Manufacturing date"
                                                styleClass="input-field"/>
                                 </children>
                              </VBox>

                              <!-- EXPIRY DATE -->
                              <VBox spacing="7.0"
                                    GridPane.columnIndex="1"
                                    GridPane.rowIndex="1">
                                 <children>
                                    <Label styleClass="field-label"
                                           text="Expiry Date"/>

                                    <DatePicker fx:id="expiryDate"
                                                maxWidth="Infinity"
                                                promptText="Expiry date"
                                                styleClass="input-field"/>
                                 </children>
                              </VBox>

                              <!-- QUANTITY RECEIVED -->
                              <VBox spacing="7.0"
                                    GridPane.columnIndex="0"
                                    GridPane.rowIndex="2">
                                 <children>
                                    <Label styleClass="field-label"
                                           text="Quantity Received"/>

                                    <TextField fx:id="quantityReceived"
                                               maxWidth="Infinity"
                                               promptText="Received quantity"
                                               styleClass="input-field"/>
                                 </children>
                              </VBox>

                              <!-- QUANTITY AVAILABLE -->
                              <VBox spacing="7.0"
                                    GridPane.columnIndex="1"
                                    GridPane.rowIndex="2">
                                 <children>
                                    <Label styleClass="field-label"
                                           text="Quantity Available"/>

                                    <TextField fx:id="quantityAvailable"
                                               maxWidth="Infinity"
                                               promptText="Available quantity"
                                               styleClass="input-field"/>
                                 </children>
                              </VBox>

                              <!-- PURCHASE PRICE -->
                              <VBox spacing="7.0"
                                    GridPane.columnIndex="0"
                                    GridPane.rowIndex="3">
                                 <children>
                                    <Label styleClass="field-label"
                                           text="Purchase Price"/>

                                    <TextField fx:id="purchasePrice"
                                               maxWidth="Infinity"
                                               promptText="Purchase price"
                                               styleClass="input-field"/>
                                 </children>
                              </VBox>

                              <!-- SELLING PRICE -->
                              <VBox spacing="7.0"
                                    GridPane.columnIndex="1"
                                    GridPane.rowIndex="3">
                                 <children>
                                    <Label styleClass="field-label"
                                           text="Selling Price"/>

                                    <TextField fx:id="sellingPrice"
                                               maxWidth="Infinity"
                                               promptText="Selling price"
                                               styleClass="input-field"/>
                                 </children>
                              </VBox>

                              <!-- PHARMACY ID -->
                              <VBox spacing="7.0"
                                    GridPane.columnIndex="0"
                                    GridPane.rowIndex="4">
                                 <children>
                                    <Label styleClass="field-label"
                                           text="Pharmacy ID"/>

                                    <TextField fx:id="pharmacyId"
                                               maxWidth="Infinity"
                                               text="PHARM-001"
                                               styleClass="input-field"/>
                                 </children>
                              </VBox>

                              <!-- BATCH STATUS -->
                              <VBox spacing="7.0"
                                    GridPane.columnIndex="1"
                                    GridPane.rowIndex="4">
                                 <children>
                                    <Label styleClass="field-label"
                                           text="Batch Status"/>

                                    <ComboBox fx:id="batchStatus"
                                              maxWidth="Infinity"
                                              promptText="Select status"
                                              styleClass="input-field"/>
                                 </children>
                              </VBox>

                              <!-- RECEIVED DATE -->
                              <VBox spacing="7.0"
                                    GridPane.columnIndex="0"
                                    GridPane.rowIndex="5">
                                 <children>
                                    <Label styleClass="field-label"
                                           text="Received Date"/>

                                    <DatePicker fx:id="receivedDate"
                                                maxWidth="Infinity"
                                                promptText="Received date"
                                                styleClass="input-field"/>
                                 </children>
                              </VBox>

                           </children>

                           <rowConstraints>
                              <RowConstraints/>
                              <RowConstraints/>
                              <RowConstraints/>
                              <RowConstraints/>
                              <RowConstraints/>
                              <RowConstraints/>
                           </rowConstraints>

                        </GridPane>

                        <!-- BATCH ACTIONS -->
                        <GridPane hgap="10.0" vgap="10.0">

                           <columnConstraints>
                              <ColumnConstraints percentWidth="50.0"/>
                              <ColumnConstraints percentWidth="50.0"/>
                           </columnConstraints>

                           <children>

                              <Button fx:id="saveBatchBtn"
                                      onAction="#doSaveBatch"
                                      styleClass="btn-primary"
                                      maxWidth="Infinity"
                                      text="Save Batch"
                                      GridPane.columnIndex="0"
                                      GridPane.rowIndex="0"/>

                              <Button fx:id="fetchBatchBtn"
                                      onAction="#doFetchBatch"
                                      styleClass="btn-secondary"
                                      maxWidth="Infinity"
                                      text="Fetch Batch"
                                      GridPane.columnIndex="1"
                                      GridPane.rowIndex="0"/>

                              <Button fx:id="updateBatchBtn"
                                      onAction="#doUpdateBatch"
                                      styleClass="btn-secondary"
                                      maxWidth="Infinity"
                                      text="Update Batch"
                                      GridPane.columnIndex="0"
                                      GridPane.rowIndex="1"/>

                              <Button fx:id="deleteBatchBtn"
                                      onAction="#doDeleteBatch"
                                      styleClass="btn-danger"
                                      maxWidth="Infinity"
                                      text="Delete Batch"
                                      GridPane.columnIndex="1"
                                      GridPane.rowIndex="1"/>

                              <Button fx:id="clearBatchBtn"
                                      onAction="#doClearBatch"
                                      styleClass="btn-secondary"
                                      maxWidth="Infinity"
                                      text="Clear"
                                      GridPane.columnIndex="0"
                                      GridPane.rowIndex="2"/>

                           </children>

                        </GridPane>

                     </children>
                  </VBox>

               </children>
            </HBox>

         </children>
      </VBox>
   </content>
</ScrollPane>
